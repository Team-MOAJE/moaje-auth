# moaje-auth environment example
# - 로컬 개발에서는 이 파일을 .env로 복사해서 사용
# - 운영에서는 파일 대신 환경변수/Secret Manager 사용을 권장함

# MySQL SQLAlchemy URL 예시 (asyncmy 드라이버)
DATABASE_URL=mysql+asyncmy://user:password@localhost:3306/moaje_auth?charset=utf8mb4

# JWT
SECRET_KEY=your-secret-key
ALGORITHM=HS256
JWT_ISSUER=moaje-auth
# JWT_AUDIENCE=moaje-services
#
# RS256 전환 시 사용:
# ALGORITHM=RS256
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----..."
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----..."
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AES-256-GCM. 아래 명령으로 생성:
# python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AES_MASTER_KEY=

# (옵션) refresh token 만료(일)
# REFRESH_TOKEN_EXPIRE_DAYS=14

# (옵션) 암복호화 키 버전(키 로테이션)
# KEY_VERSION=1
