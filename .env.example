# moaje-auth environment example
# - 로컬 개발에서는 이 파일을 .env로 복사해서 사용
# - 운영에서는 파일 대신 환경변수/Secret Manager 사용을 권장함

# MySQL SQLAlchemy URL 예시 (asyncmy 드라이버)
DATABASE_URL=mysql+asyncmy://user:password@localhost:3306/moaje_auth?charset=utf8mb4

# JWT
SECRET_KEY=your-secret-key
ALGORITHM=HS256
JWT_ISSUER=moaje-auth
# JWT_AUDIENCE=moaje-services
#
# RS256 전환 시 사용:
# ALGORITHM=RS256
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----..."
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----..."
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AES-256-GCM. 아래 명령으로 생성:
# python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AES_MASTER_KEY=

# 로그인 세션: 마지막 토큰 갱신 이후 7일
REFRESH_TOKEN_EXPIRE_DAYS=7

# SMS 인증. 실제 운영에서는 provider adapter와 공급자 Secret 설정 필요.
# 로컬 테스트에서만 dev를 사용하고, 인증번호 응답 노출은 명시적으로 켭니다.
SMS_PROVIDER=disabled
SMS_OTP_EXPIRE_MINUTES=5
SMS_OTP_MAX_ATTEMPTS=5
SMS_REQUEST_COOLDOWN_SECONDS=60
SMS_HOURLY_REQUEST_LIMIT=5
SMS_DEV_EXPOSE_CODE=false

# 6자리 간편 비밀번호 연속 실패 제한
PIN_MAX_ATTEMPTS=5
PIN_LOCK_MINUTES=30

# (옵션) 암복호화 키 버전(키 로테이션)
# KEY_VERSION=1

# (옵션) gRPC AuthService 포트
# GRPC_PORT=50051

# Work -> Auth CompleteOnboarding 전용 공유 토큰. 미설정 시 호출 거절.
# 충분히 긴 랜덤 값을 생성해 Auth와 Work에만 설정하고 커밋하지 마세요.
# 로컬 외 환경에서는 gRPC TLS와 함께 사용하세요.
# WORK_SERVICE_TOKEN=

# (옵션) gRPC TLS. 운영 환경에서는 필수.
# 값 둘 다 없으면 TLS 없이 기동(로컬 개발 전용, 경고 로그 발생)
# GRPC_TLS_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# GRPC_TLS_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
